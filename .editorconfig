# EditorConfig -- https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.gradle]
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
